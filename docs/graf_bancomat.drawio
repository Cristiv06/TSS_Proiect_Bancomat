        <mxCell id="e23" value="arc adăugat 17 → 1" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;dashed=1;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="n17" target="n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="1062"/><mxPoint x="860" y="62"/></Array></mxGeometry></mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Graful metodei Bancomat.retrage&lt;/b&gt;&lt;br&gt;[1] if (suma &amp;lt; 10 || suma &amp;gt; 5000 || suma % 10 != 0)&lt;br&gt;[2] return SUMA_INVALIDA&lt;br&gt;[3] if (!(suma &amp;lt;= sold || (premium &amp;amp;&amp;amp; suma &amp;lt;= sold + 1000)))&lt;br&gt;[4] return FONDURI_INSUFICIENTE&lt;br&gt;[5] limita = 5000; if (premium)&lt;br&gt;[6] limita = 10000&lt;br&gt;[7] if (retrasAzi + suma &amp;gt; limita)&lt;br&gt;[8] return LIMITA_DEPASITA&lt;br&gt;[9] bancnote = new int[4]; rest = suma; i = 0&lt;br&gt;[10] while (i &amp;lt; 4 &amp;amp;&amp;amp; rest &amp;gt; 0)&lt;br&gt;[11] nr = rest / DENOMINATII[i]; if (nr &amp;gt; stoc[i])&lt;br&gt;[12] nr = stoc[i]&lt;br&gt;[13] bancnote[i] = nr; rest -= nr * DENOMINATII[i]; i++&lt;br&gt;[14] if (rest != 0)&lt;br&gt;[15] return BANCNOTE_INSUFICIENTE&lt;br&gt;[16] return SUCCES&lt;br&gt;[17] sfarsit&lt;br&gt;&lt;br&gt;n = 17 noduri, e = 23 + 1 (arcul 17 → 1) = 24 arce&lt;br&gt;&lt;b&gt;V(G) = e − n + 1 = 24 − 17 + 1 = 8&lt;/b&gt;&lt;br&gt;7 decizii (1, 3, 5, 7, 10, 11, 14) + 1 = 8&lt;br&gt;&lt;br&gt;albastru = nod de decizie, rosu = return, verde = sfarsit" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=8;strokeColor=#999999;fillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="900" y="40" width="470" height="520" as="geometry"/></mxCell>
      </root>
